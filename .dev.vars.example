# コピーして .dev.vars にし，値を入れる（.dev.vars は git に入れない）

# 必須: Slack アプリ設定 → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=""

# 推奨ルート: Slack アプリ設定 → OAuth & Permissions → Install to Workspace → Bot User OAuth Token（xoxb- で始まる）
SLACK_BOT_TOKEN=""

# 任意（OAuth の /install → /accept を使うときだけ）: Basic Information → Client ID / Client Secret
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
